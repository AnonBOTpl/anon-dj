{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANON DJ Kiosk",
  "version": "0.1.0",
  "identifier": "pl.anondj.kiosk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ANON DJ — Kiosk",
        "width": 1280,
        "height": 800,
        "center": true,
        "resizable": false,
        "decorations": false,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
